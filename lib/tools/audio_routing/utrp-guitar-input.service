[Unit]
Description=Persistent Spark GO guitar input for Bitwig
After=pipewire.service
Wants=pipewire.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/pw-loopback --name=utrp_guitar --channels=1 --channel-map=MONO --capture-props="node.name=utrp_guitar_capture node.description=Spark-GO-Internal-Capture node.autoconnect=false node.passive=true node.latency=128/48000" --playback-props="node.name=utrp_guitar_input node.description=Spark-GO-Guitar media.class=Audio/Source node.virtual=true priority.session=0"
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
