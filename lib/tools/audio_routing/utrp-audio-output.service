[Unit]
Description=Prefer Spark GO playback and maintain the dedicated Bitwig guitar input
After=pipewire.service wireplumber.service pipewire-pulse.service utrp-guitar-input.service
Wants=pipewire.service wireplumber.service pipewire-pulse.service utrp-guitar-input.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/work/utrp/lib/tools/audio_routing/policy.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
