@init
// State is private to each JSFX instance, never gmem/global across instances.
// Channel 16: computer controls. Channel 15: display-only analysis. Hardware: 1..14.
function emit_sustain(ch,offset) (
  // S is the pedal-up baseline; CC64 temporarily inverts it on its channel.
  midisend(offset,$xb0+ch,64,sustain_on!=pedal_down[ch] ? 127 : 0);
);
function release_chord(offset) local(i,n) (
  i=0;
  loop(guitar_voice_capacity,
    n=voices[i];
    n>=0 ? (
      own[n]=0;
      held[n]==0 ? midisend(offset,$x80,n,0);
      voices[i]=-1;
    );
    i+=1;
  );
  sounding=0;
);
function start_chord(offset) local(i,n,region,count) (
  // Receivers can load/activate after the one-shot startup CC. Reassert the
  // effective pedal at the attack boundary, before releasing/retriggering notes.
  emit_sustain(0,offset);
  // Release the old note set first; duplicate pitches on two strings emit once.
  release_chord(offset);
  i=0; count=0; region=guitar_current();
  loop(voicing_mode ? region[1] : voice_count,
    n=voicing_mode ? region[i+2] :
      chord_note(key,degree,inversion,i,centre,voice_count);
    chord_includes(n,key,degree,rootless_saved[degree]) ? !own[n] ? (
      voices[count]=n; count+=1; own[n]=1;
      // Rearticulate a shared pitch without stacking unmatched synth voices.
      held[n]>0 ? midisend(offset,$x80,n,0);
      midisend(offset,$x90,n,velocity);
    );
    i+=1;
  );
  sounding=count>0;
);
function select_voicing_mode(value,offset) (
  voicing_mode!=value ? (
    voicing_mode=value; slider20=value; sliderchange(524288); slider_automate(524288);
    sounding ? start_chord(offset);
  );
);
function publish_voicing() (
  voice_count=3+kind;
  slider3=inversion; slider4=centre; slider16=kind; sliderchange(32780);
);
function recall_voicing() local(index) (
  index=saved+degree*4;
  kind=index[1]; inversion=index[2]; centre=index[3]; publish_voicing();
);
function save_voicing() local(index) (
  index=saved+degree*4;
  index[0]=1; index[1]=kind; index[2]=inversion; index[3]=centre;
  slider15=(slider15+1)%1000001; sliderchange(16384);
);
function move_voicing(direction,offset) local(oldlow,nextinv,nextlow,nextcentre,rawlow,rawnext,attempt) (
  voicing_mode ? (
    guitar_move(direction) ? (
      slider15=(slider15+1)%1000001; sliderchange(16384);
      sounding ? start_chord(offset);
    );
  ) : (
  oldlow=piano_bass(key,degree,inversion,centre,voice_count,rootless_saved[degree]);
  nextinv=inversion; nextcentre=centre; nextlow=oldlow; attempt=0;
  // Rootless inversions can share the same bass. Skip that duplicate step;
  // still walk the original rooted ordering so restoring G preserves pitches.
  while(attempt<voice_count && (nextlow-oldlow)*direction<=0) (
    rawlow=chord_note(key,degree,nextinv,0,nextcentre,voice_count);
    nextinv=(nextinv+direction+voice_count)%voice_count;
    rawnext=chord_note(key,degree,nextinv,0,nextcentre,voice_count);
    direction>0 && rawnext<=rawlow ? nextcentre+=12;
    direction<0 && rawnext>=rawlow ? nextcentre-=12;
    nextlow=piano_bass(key,degree,nextinv,nextcentre,voice_count,rootless_saved[degree]);
    attempt+=1;
  );
  nextcentre>=12 && nextcentre<=115 && (nextlow-oldlow)*direction>0 ? (
    inversion=nextinv; centre=nextcentre; publish_voicing(); save_voicing();
    sounding ? start_chord(offset);
  );
  );
);
function toggle_rootless(offset) (
  rootless_saved[degree]=!rootless_saved[degree]; save_voicing();
  sounding ? start_chord(offset);
);
function cycle_kind(offset) (
  kind=(kind+1)%3; inversion=inversion%(3+kind); publish_voicing(); save_voicing();
  sounding ? start_chord(offset);
);
// Seven computer keys plus one mouse button: last-held chord has priority.
function update_gate(offset) local(i,best,stamp) (
  i=0; best=-1; stamp=0;
  loop(8,
    chord_held[i]>stamp ? (best=i; stamp=chord_held[i];);
    i+=1;
  );
  best!=active_slot ? (
    active_slot=best;
    best<0 ? release_chord(offset) : (
      degree=best==7 ? mouse_degree : (best+5)%7;
      slider2=degree; sliderchange(2); recall_voicing(); start_chord(offset);
    );
  );
);
function press_degree(slot,offset) (
  !game_on && !chord_held[slot] ? (
    gate_serial+=1; chord_held[slot]=gate_serial; update_gate(offset);
  );
);
function release_degree(slot,offset) (
  chord_held[slot]=0; update_gate(offset);
);
function set_sustain(value,offset) local(ch) (
  sustain_on=value; slider18=value; sliderchange(131072);
  ch=0; loop(14,emit_sustain(ch,offset); ch+=1;);
);
function release_controls(offset) (
  memset(chord_held,0,8); memset(control_held,0,128);
  active_slot=-1; gate_serial=0; release_chord(offset);
  // Focus/visibility changes release keys, not the user's pedal-up baseline.
);
function stop_controls(offset) (
  release_controls(offset);
  set_sustain(0,offset);
);
function command(cmd,offset) (
  (!game_on || cmd==22 || cmd==23 || cmd==24 || cmd==26 || cmd==27) ? (
  cmd>=0 && cmd<12 ? (
    !sounding && !(play_state&1) && play_state!=5 ? (
      key=cmd; slider1=key; sliderchange(1); slider_automate(1); recall_voicing();
    );
  ) : cmd>=12 && cmd<19 ? (
    mouse_degree=(cmd-12+5)%7;
    press_degree(7,offset);
  ) : cmd==19 ? move_voicing(-1,offset)
    : cmd==20 ? move_voicing(1,offset)
    : cmd==21 ? (
      // Enter restores this degree rooted; position resets only in the current mode.
      // Chord type and other degrees/mode positions remain unchanged.
      rootless_saved[degree]=0;
      voicing_mode ? (
        guitar_saved[degree]=guitar_default_anchor;
        slider15=(slider15+1)%1000001; sliderchange(16384);
      ) : (
        inversion=0; centre=60; publish_voicing(); save_voicing();
      );
      sounding ? start_chord(offset);
    ) : cmd==23 ? release_controls(offset)
    : cmd==24 ? release_degree(7,offset)
    : cmd==25 ? cycle_kind(offset)
    : cmd==22 || cmd==26 ? set_sustain(!sustain_on,offset)
    : cmd==27 ? set_sustain(0,offset)
    : cmd==28 ? select_voicing_mode(0,offset)
    : cmd==29 ? select_voicing_mode(1,offset)
    : cmd==30 ? toggle_rootless(offset);
);
);
function receive_midi(offset,status,note,value) local(type,ch,index) (
  type=status&$xf0; ch=status&15;
  ch==15 ? (
    // Reserved VKB channel is never forwarded to the instrument.
    index=note-60;
    type==$x90 && value>0 && enabled && slider14 ? (
      !control_held[note] ? (
        control_held[note]=1;
        index>=12 && index<19 ? press_degree(index-12,offset) : command(index,offset);
      );
    );
    type==$x80 || (type==$x90 && value==0) ? (
      control_held[note]=0;
      index>=12 && index<19 ? release_degree(index-12,offset);
    );
    type==$xb0 && (note==120 || note==123) ? release_controls(offset);
  ) : ch==14 ? (
    // Analysis notes share the visual held map, never the instrument ownership.
    // Swallow all channel messages, including Sustain, bend and channel reset.
    index=ch*128+note;
    type==$x90 && value>0 ? held[index]+=1
      : type==$x80 || (type==$x90 && value==0) ? held[index]=max(0,held[index]-1)
      : type==$xb0 && (note==120 || note==123) ? memset(held+ch*128,0,128);
  ) : (
    index=ch*128+note;
    type==$x90 && value>0 ? (
      // The indicator alone does not prove a late downstream instrument heard it.
      emit_sustain(ch,offset);
      // Every physical attack sounds, even when the computer owns this pitch.
      // Logical owners survive the off/on pair until their own input releases.
      held[index]>0 || (ch==0 && own[note]) ? midisend(offset,$x80+ch,note,0);
      held[index]+=1;
      midisend(offset,status,note,value);
    ) : type==$x80 || (type==$x90 && value==0) ? (
      held[index]=max(0,held[index]-1);
      held[index]==0 && !(ch==0 && own[note]) ? midisend(offset,status,note,value);
    ) : type==$xb0 && (note==120 || note==123) ? (
      memset(held+ch*128,0,128);
      pedal_down[ch]=0;
      sustain_on ? set_sustain(0,offset);
      ch==0 ? stop_controls(offset);
      midisend(offset,status,note,value);
      emit_sustain(ch,offset);
    ) : type==$xb0 && note==121 ? (
      pedal_down[ch]=0;
      midisend(offset,status,note,value);
      emit_sustain(ch,offset);
    ) : type==$xb0 && note==64 ? (
      pedal_down[ch]=value>=64;
      emit_sustain(ch,offset);
    ) : (
      midisend(offset,status,note,value);
    );
  );
);
