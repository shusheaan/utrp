desc:Chord Lab — chord voicing explorer
// MIDI only. Put in Input FX to record the generated notes.
tags: MIDI generator chord keyboard
in_pin:none
out_pin:none
filename:0,notation.png
slider1:0<0,11,1{C,Db,D,Eb,E,F,Gb,G,Ab,A,Bb,B}>-Key
slider2:0<0,6,1>-Degree
slider3:0<0,4,1>-Inversion
slider4:60<12,115,1>-Voicing centre (MIDI)
slider5:88<1,127,1>-Velocity
slider6:1<0,1,1>-Enabled
slider7:0<0,1000000,1>-Command serial
slider8:23<0,25,1>-Command
slider9:0<0,1,1>-Sounding (read only)
slider10:0<0,127,1>-Voice 1 (read only)
slider11:0<0,127,1>-Voice 2 (read only)
slider12:0<0,127,1>-Voice 3 (read only)
slider13:0<0,127,1>-Voice 4 (read only)
slider14:0<0,1,1>-Computer mode (read only)
slider15:0<0,1000000,1>-Voicing memory revision

slider16:1<0,2,1{Triad,Seventh,Ninth}>-Chord type
slider17:0<0,127,1>-Voice 5 (read only)

import harmony.jsfx-inc
import midi.jsfx-inc
import theme.jsfx-inc
import ui.jsfx-inc
import staff.jsfx-inc

@init
ext_noinit=1;
ext_midi_bus=1;
held=0; own=2048; voices=2200; control_held=2300; chord_held=2440;
memset(held,0,2560);
saved=3000; memory_index=0; loop(7,
  cell=saved+memory_index*4; cell[0]=0; cell[1]=1; cell[2]=0; cell[3]=60;
  memory_index+=1;
);
memset(voices,-1,5);
key=slider1; degree=slider2; inversion=slider3; kind=slider16; voice_count=3+kind;
centre=slider4; velocity=slider5; enabled=slider6;
sounding=0; slider9=0; serial=slider7;
active_slot=-1; gate_serial=0; previous_mode=slider14;
ui_read=ui_write=0; ui_queue=2600;
previous_play=play_state;

@slider
// Only @block mutates audio state or sends MIDI.
settings_dirty=1;

@block
midi_bus=0;
// A hidden/closed UI cannot deliver its mouse-up; expire only the mouse gate.
chord_held[7] && time_precise()-ui_heartbeat>0.5 ? release_degree(7,0);
settings_dirty ? (
  slider1=min(11,max(0,floor(slider1)));
  slider2=min(6,max(0,floor(slider2)));
  slider16=min(2,max(0,floor(slider16)));
  slider3=min(2+slider16,max(0,floor(slider3)));
  slider4=min(115,max(12,floor(slider4)));
  slider5=min(127,max(1,floor(slider5)));
  key_locked=sounding || (play_state&1) || play_state==5;
  key_locked ? slider1=key : key=slider1;
  changed=(degree!=slider2 || inversion!=slider3 || centre!=slider4 || kind!=slider16);
  degree=slider2; inversion=slider3; centre=slider4; velocity=slider5;
  kind=slider16; voice_count=3+kind;
  enabled=slider6;
  !enabled || (previous_mode && !slider14) ? stop_controls(0) : changed && sounding ? start_chord(0);
  previous_mode=slider14; settings_dirty=0;
);
(previous_play&1) && !(play_state&1) ? stop_controls(0);
previous_play=play_state;
slider7!=serial ? (
  serial=slider7;
  enabled || slider8==23 ? command(slider8,0);
);
while(ui_read!=ui_write) (
  cmd=ui_queue[ui_read]; ui_read=(ui_read+1)%32;
  enabled || cmd==23 ? command(cmd,0);
);
while(midirecv(offset,status,note,value)) (
  midi_bus==0 ? receive_midi(offset,status,note,value) : midisend(offset,status,note,value);
);
slider9=sounding;
slider10=max(0,voices[0]); slider11=max(0,voices[1]);
slider12=max(0,voices[2]); slider13=max(0,voices[3]); slider17=max(0,voices[4]);

@serialize
// v2: seven degree records shared across keys. v1 migrates the current key.
file_avail(0)>=0 ? (
  file_var(0,memory_version);
  memory_version==1 ? (
    file_mem(0,4000,252); memory_index=0;
    loop(7,
      oldcell=4000+(slider1*7+memory_index)*3; cell=saved+memory_index*4;
      oldcell[0]==1 ? (cell[0]=1; cell[1]=1; cell[2]=oldcell[1]; cell[3]=oldcell[2];);
      memory_index+=1;
    );
  ) : memory_version==2 ? file_mem(0,saved,28);
  memory_index=0; loop(7,
    cell=saved+memory_index*4;
    !((cell[0]==0 || cell[0]==1) && cell[1]>=0 && cell[1]<=2 && cell[1]==floor(cell[1]) &&
      cell[2]>=0 && cell[2]<3+cell[1] && cell[2]==floor(cell[2]) &&
      cell[3]>=12 && cell[3]<=115 && cell[3]==floor(cell[3])) ? (
        cell[0]=0; cell[1]=1; cell[2]=0; cell[3]=60;
      );
    memory_index+=1;
  );
) : (
  memory_version=2; file_var(0,memory_version); file_mem(0,saved,28);
);

@gfx 884 683
// Two equal diagram groups: major-scale context above, selected chord below.
// No internal title row: reserve the reclaimed 36px for the external VKB.
layout_group_height=max(160,floor((gfx_h-142)/2));
layout_available=layout_group_height-12;
layout_piano_height=floor(layout_available*piano_height_ratio/(piano_height_ratio+guitar_height_ratio));
layout_guitar_height=layout_available-layout_piano_height;
layout_staff_width=min(170,max(156,(gfx_w-36)*.21));
layout_map_x=18+layout_staff_width+14;
layout_map_width=max(1,gfx_w-layout_map_x-18);
layout_chord_y=72+layout_group_height;
ui_begin();
draw_key_choices(10);
draw_maps(layout_map_x,47,layout_map_width,layout_piano_height,layout_guitar_height,1);
draw_staff(18,47,layout_staff_width,layout_group_height,1);
draw_chord_choices(layout_chord_y);
draw_maps(layout_map_x,layout_chord_y+41,layout_map_width,layout_piano_height,layout_guitar_height,0);
draw_staff(18,layout_chord_y+41,layout_staff_width,layout_group_height,0);
