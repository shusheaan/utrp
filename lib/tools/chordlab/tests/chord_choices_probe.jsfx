desc:Chord Lab contextual chord choices regression
import ../harmony.jsfx-inc
import ../guitar_table.jsfx-inc
import ../guitar.jsfx-inc
import ../midi.jsfx-inc
import ../game.jsfx-inc
import ../theme.jsfx-inc
import ../ui.jsfx-inc
@init
failures=0; saved=3000; rootless_saved=3200; guitar_saved=3100; key=0; degree=0; voicing_mode=0;
i=0; loop(7,saved[i*4+3]=60; i+=1;);
function check(value) (!value ? failures+=1;);
function check_text(d,expected) (
  chord_choice_text(d); check(strcmp(#text,expected)==0);
);
check_text(0,"I C/C4(1)"); check(chord_choice_selected(0));
game_on=1; game_count=0;
check_text(0,"I C/C4(1)"); check(!chord_choice_selected(0));
game_count=3; game_signature=0; game_root=0; game_root_letter=0; game_quality=0;
game_roles[0]=1; game_notes[0]=64; game_letters[0]=2;
i=0; loop(7,game_scale[i]=major_step(i); game_scale_letters[i]=i; i+=1;);
check_text(0,"I C/E4(3)"); check_text(1,"ii Dm"); check_text(6,"vii° Bdim");
check(chord_choice_selected(0)); check(!chord_choice_selected(1));
// Ordinary game, before any answer: labels never reveal diagram notes.
check(!game_visible(64)); game_seen[64]=1; check(game_visible(64));
// Borrowed bII never replaces or selects a fixed diatonic capsule.
game_root=1; game_root_letter=1; game_degree=-1; game_notes[0]=65; game_letters[0]=3;
check_text(1,"ii Dm"); check(!chord_choice_selected(1)); check(game_choice_degree()==-1); check_text(0,"I C");
// A minor keeps the fixed C-major palette: A is blue, not a new red tonic.
game_signature=0; game_tonic=9; game_minor=1; game_root=4; game_root_letter=2;
game_quality=6; game_notes[0]=56; game_letters[0]=4;
i=0; loop(7,game_scale[i]=major_step(i+5)%12; game_scale_letters[i]=(i+5)%7; i+=1;);
check_text(5,"vi Am"); check_text(6,"vii° Bdim"); check_text(0,"I C");
check_text(2,"iii Em"); check(game_choice_degree()==-1);
check(chord_choice_role(5)==3); check(chord_choice_role(0)==0);
// Seventh context, and bass degree uses the chord rather than the key.
game_count=4; check_text(5,"vi Am7"); check_text(6,"viiø Bm7b5"); check_text(0,"I Cmaj7");
game_root=9; game_root_letter=5; game_quality=5; game_roles[0]=3;
game_notes[0]=55; game_letters[0]=4; check_text(5,"vi Am7/G3(b7)"); check(chord_choice_selected(5));
game_on=0; key=0; saved[1]=1; saved[2]=3;
check_text(0,"I CM7/B3(7)"); saved[1]=0; saved[2]=0; game_on=1;
// Exhaustive roots in every major/minor context: selection and palette agree
// with the same scale-degree mapping used by the upper note diagram.
k=0; loop(12,
  mode=0; loop(2,
    game_signature=k; game_minor=mode; i=0;
    loop(7,
      game_scale[i]=(k+major_step(i+mode*5))%12;
      game_scale_letters[i]=(key_letter(k)+i+mode*5)%7; i+=1;
    );
    d=0; loop(7,
      game_root=(k+major_step(d))%12; game_root_letter=(key_letter(k)+d)%7;
      game_quality=d==6 ? 7 : d==4 ? 6 : d==0 || d==3 ? 4 : 5;
      check(game_choice_degree()==d); check(chord_choice_selected(d));
      check(chord_choice_role(d)==scale_role(game_root,k));
      check(chord_choice_role(d)==display_role(game_root,1));
      check(role_color(chord_choice_role(d))==role_color(display_role(game_root,1)));
      d+=1;
    ); mode+=1;
  ); k+=1;
);
// Borrowed qualities on a diatonic root must not hijack a normal capsule.
game_signature=0;game_count=4;game_root=5;game_root_letter=3;game_quality=5;
check(game_choice_degree()==-1); check_text(3,"IV Fmaj7");
game_root=2;game_root_letter=1;game_quality=6;
check(game_choice_degree()==-1); check_text(1,"ii Dm7");
// Pitch visibility and judging remain independent of capsule membership.
game_seen[66]=1; check(game_visible(66));
// Read-only game display cannot change normal key/degree or saved voicings.
check(key==0 && degree==0 && saved[3]==60);
game_on=0; check_text(0,"I C/C4(1)"); check(chord_choice_selected(0));
// Rootless labels use the actual bass; identity, degree and palette do not move.
rootless_saved[0]=1; check_text(0,"I C/E4(3) RL");
saved[1]=1; check_text(0,"I CM7/E4(3) RL");
saved[2]=3; check_text(0,"I CM7/B3(7) RL");
saved[1]=2; saved[2]=0; check_text(0,"I CM9/D4(9) RL");
voice_count=5; check(display_role(60,0)==-1); check(display_role(60,1)==0);
check(display_role(62,0)==4); check(chord_choice_role(0)==0);
check_text(1,"ii Dm/D4(1)");
game_on=1;game_count=4;game_root=0;game_root_letter=0;game_quality=4;
game_roles[0]=0;game_notes[0]=60;game_letters[0]=0;
check_text(0,"I Cmaj7/C4(1)");check(display_role(60,0)==0);
game_on=0;rootless_saved[0]=0;saved[1]=0;saved[2]=0;
// Stable fixture for the real pixel/hit-test harness.
game_count=3; game_signature=0; game_root=0; game_root_letter=0; game_quality=0;
i=0; loop(7,game_scale[i]=major_step(i); game_scale_letters[i]=i; i+=1;);
// Configured only by the pixel harness; production rendering stays unchanged.
function pixel_context(k,mode,d,external) local(i) (
  game_on=1;game_count=4;game_signature=k;game_minor=mode;
  i=0;loop(7,
    game_scale[i]=(k+major_step(i+mode*5))%12;
    game_scale_letters[i]=(key_letter(k)+i+mode*5)%7;i+=1;
  );
  game_root=(k+major_step(d))%12;game_root_letter=(key_letter(k)+d)%7;
  game_quality=external ? 8 : game_choice_quality(d);
  game_notes[0]=60+game_root;game_roles[0]=0;game_letters[0]=game_root_letter;
);
@gfx 884 80
pixel_enabled ? pixel_context(pixel_signature,pixel_mode,pixel_degree,pixel_external);
// Pixel probe runs the same complete row, including hit testing and font fitting.
gfx_clear=0; ink(background_color,1); gfx_rect(0,0,gfx_w,gfx_h);
measure_choice_text(); draw_chord_choices(20);
