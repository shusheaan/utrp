desc:Capsule pixel bounds probe
import ../harmony.jsfx-inc
import ../guitar_table.jsfx-inc
import ../guitar.jsfx-inc
import ../midi.jsfx-inc
import ../game.jsfx-inc
import ../ui.jsfx-inc
@init
shape_width=160; shape_height=29;
@gfx 220 80
gfx_clear=0;
gfx_set(0,0,0,1); gfx_rect(0,0,gfx_w,gfx_h);
gfx_set(1,1,1,1); capsule(20,20,shape_width,shape_height);
