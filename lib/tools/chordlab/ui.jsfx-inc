@init
// UI submits commands; MIDI state is owned exclusively by @block.
function ui_command(cmd) local(next) (
  next=(ui_write+1)%32;
  next!=ui_read ? (ui_queue[ui_write]=cmd; ui_write=next;);
);
function ink(hex,alpha) (
  gfx_set(((hex>>16)&255)/255,((hex>>8)&255)/255,(hex&255)/255,alpha);
);
function label(x,y,text,size,color) (
  gfx_setfont(1,"DejaVu Sans",size*font_scale);
  ink(color,1); gfx_x=x; gfx_y=y; gfx_drawstr(text);
);
function centered_style(x,y,w,h,text,size,color,bold) (
  gfx_setfont(1,"DejaVu Sans",size*font_scale,bold ? 'b' : 0); ink(color,1);
  gfx_x=x; gfx_y=y; gfx_drawstr(text,5,x+w,y+h);
);
function centered(x,y,w,h,text,size,color) (centered_style(x,y,w,h,text,size,color,0););
function hover(x,y,w,h) (
  mouse_x>=x && mouse_x<x+w && mouse_y>=y && mouse_y<y+h;
);
// Continuous rail with an inset selection. Hit regions remain contiguous.
function capsule(x,y,w,h) local(r) (
  // LICE circles include both endpoint pixels: diameter is 2*r+1.
  // Use integer pixel centres, matching the rectangle's [y,y+h) bounds.
  r=(min(w,h)-1)/2;
  gfx_rect(x+r,y,w-2*r-1,h);
  gfx_circle(x+r,y+r,r,1,1);
  gfx_circle(x+w-1-r,y+r,r,1,1);
);
function choice_button(x,y,w,text,selected,locked) local(hit,pad) (
  hit=hover(x,y,w,choices_height); pad=choices_inset;
  selected || (hit && !locked) ? (
    ink(selected ? button_selected_color : button_hover_color,1);
    capsule(x+pad,y+pad,w-2*pad,choices_height-2*pad);
  );
  centered(x,y,w,choices_height,text,choices_text_size,
    selected ? text_selected_color : locked ? text_muted_color : text_color);
  hit && clicked && !locked;
);
function role_color(role) (
  role==0 ? root_color : role==1 ? third_color : role==2 ? fifth_color : role==3 ? seventh_color : ninth_color;
);
function hardware_held(note) local(hw,ch) (
  hw=0; ch=0; loop(15,hw+=held[ch*128+note]; ch+=1;); hw;
);
function role_ink(role,lit) local(color) (
  color=role_color(role);
  lit ? ink(color,1) : gfx_set(
    ((1-note_idle_mix)*((note_idle_base_color>>16)&255)+note_idle_mix*((color>>16)&255))/255,
    ((1-note_idle_mix)*((note_idle_base_color>>8)&255)+note_idle_mix*((color>>8)&255))/255,
    ((1-note_idle_mix)*(note_idle_base_color&255)+note_idle_mix*(color&255))/255,1);
);
// Use the same degree fill/white text as scale notes in both normal and game mode.
function chord_choice_button(x,y,w,text,selected,locked,role) local(hit,pad) (
  hit=hover(x,y,w,choices_height); pad=choices_inset;
  selected ? (
    ink(active_note_ring_color,1);
    capsule(x+pad-1,y+pad-1,w-2*pad+2,choices_height-2*pad+2);
  );
  role_ink(role,selected || (hit && !locked));
  capsule(x+pad,y+pad,w-2*pad,choices_height-2*pad);
  centered(x,y,w,choices_height,text,choices_text_size,note_text_color);
  hit && clicked && !locked;
);
// Preserve fractional centres on both axes, including even-width white keys.
// The scratch image grows with the marker so larger windows cannot clip it.
function note_circle(x,y,radius) local(destination,left,top,half,side,alpha) (
  x==floor(x) && y==floor(y) ? gfx_circle(x,y,radius,1,1) : (
    destination=gfx_dest; alpha=gfx_a; gfx_a=1; left=floor(x); top=floor(y);
    half=ceil(radius)+3; side=half*2;
    gfx_setimgdim(1,side,side); gfx_dest=1;
    gfx_muladdrect(0,0,side,side,0,0,0,0,gfx_r,gfx_g,gfx_b,0);
    gfx_circle(half,half,radius,1,1);
    gfx_dest=destination; gfx_a=alpha;
    gfx_blit(1,1,0,left-x,top-y,side,side,left-half,top-half,side,side);
  );
);
// Glow and thin rim are outside the unchanged fill and label footprint.
function active_note_halo(x,y,radius,role,ring) local(color,r,g,b) (
  color=role>=0 ? role_color(role) : external_color;
  r=((color>>16)&255)/255; g=((color>>8)&255)/255; b=(color&255)/255;
  r+=(1-r)*active_note_glow_mix;
  g+=(1-g)*active_note_glow_mix;
  b+=(1-b)*active_note_glow_mix;
  gfx_set(r,g,b,active_note_glow_outer_alpha);
  note_circle(x,y,radius+active_note_ring_width+active_note_glow_width);
  gfx_set(r,g,b,active_note_glow_inner_alpha);
  note_circle(x,y,radius+active_note_ring_width+active_note_glow_width*.5);
  ring ? (ink(active_note_ring_color,1); note_circle(x,y,radius+active_note_ring_width););
);
// One circle/text renderer shared by staff, keyboard and guitar.
function note_dot(x,y,role,note,scale_view,radius) local(lit,hw,tw,th,size,fit,ring) (
  game_visible(note) ? (
  hw=hardware_held(note); lit=(sounding && own[note]) || hw>0;
  game_on ? lit=game_visible(note);
  ring=lit && display_role(note,1)>=0;
  lit ? active_note_halo(x,y,radius,role,ring);
  role>=0 ? role_ink(role,lit) : ink(external_color,1);
  note_circle(x,y,radius);
  game_on ? game_spell(#tone,note%12,game_letter(note)) :
    role>=0 && !scale_view ? spell_note(#tone,key,degree+role*2) : spell_pitch(#tone,key,note);
  // Measure the actual string, not a guessed rectangle; shrink accidentals to fit.
  size=note_font_size*radius/note_radius;
  gfx_setfont(5,"DejaVu Sans",size,'b');
  gfx_measurestr(#tone,tw,th);
  fit=min(1,radius*1.85/max(1,tw));
  fit<1 ? (
    size*=fit; gfx_setfont(5,"DejaVu Sans",size,'b'); gfx_measurestr(#tone,tw,th);
  );
  ink(note_text_color,1);
  gfx_x=x-tw/2; gfx_y=y-th/2; gfx_drawstr(#tone);
);
);
// An odd, integer black-key width has one exact centre pixel. gfx_circle's
// fill diameter is 2*r+1 pixels, matching that key; only the soft halo extends outside.
function keyboard_black_width(w) (2*floor(w/29*.33)+1;);
function dot(x,y,role,note,scale_view) (
  note_dot(x,y,role,note,scale_view,(keyboard_black_width(layout_map_width)-1)/2);
);
function external_dot(x,y,note,scale_view) ((game_on ? game_visible(note) : hardware_held(note)>0) ? dot(x,y,-1,note,scale_view););
function is_black(pc) (pc==1 || pc==3 || pc==6 || pc==8 || pc==10;);
function draw_keyboard(x,y,w,h,scale_view) local(i,n,pc,white,kx,kw,bw,left,right,cx,role,ch,hw) (
  kw=w/29; bw=keyboard_black_width(w); white=0; i=0;
  loop(49,
    n=38+i; pc=n%12;
    !is_black(pc) ? (
      kx=x+white*kw;
      left=floor(kx+.8); right=floor(kx+kw-.8); cx=(left+right-1)/2;
      ink(key_white_color,1); gfx_rect(left,y,right-left,h);
      theme_dark ? (ink(key_divider_color,1); gfx_rect(left,y,dark_diagram_line_width,h); gfx_rect(left,y+h-dark_diagram_line_width,right-left,dark_diagram_line_width););
      role=display_role(n,scale_view);
      role>=0 ? dot(cx,y+h-27,role,n,scale_view);
      role<0 ? external_dot(cx,y+h-27,n,scale_view);
      (pc==0 || i==0 || i==48) ? (sprintf(#oct,pc==0 ? "C%d" : "D%d",floor(n/12)-1); centered(kx,y+h-15,kw,12,#oct,8,octave_label_color););
      white+=1;
    );
    i+=1;
  );
  white=0; i=0;
  loop(49,
    n=38+i; pc=n%12;
    is_black(pc) ? (
      cx=floor(x+white*kw+.5); kx=cx-(bw-1)/2;
      ink(key_black_color,1); gfx_rect(kx,y,bw,h*.61);
      ink(key_black_inner_color,1); gfx_rect(kx+2,y+2,bw-4,h*.61-6);
      role=display_role(n,scale_view);
      role>=0 ? dot(cx,floor(y+h*.61-18+.5),role,n,scale_view);
      role<0 ? external_dot(cx,floor(y+h*.61-18+.5),n,scale_view);
    ) : white+=1;
    i+=1;
  );
  // Frame stays inside existing keyboard bounds; marker centres never move.
  theme_dark ? (
    ink(key_divider_color,1);
    gfx_rect(x,y,w,dark_diagram_line_width);
    gfx_rect(x,y+h-dark_diagram_line_width,w,dark_diagram_line_width);
    gfx_rect(x,y,dark_diagram_line_width,h);
    gfx_rect(x+w-dark_diagram_line_width,y,dark_diagram_line_width,h);
  );
);
function guitar_open(string) (
  string==0 ? 64 : string==1 ? 59 : string==2 ? 55 :
  string==3 ? 50 : string==4 ? 45 : 40;
);
function fret_marker(fret) (
  fret==12 ? 2 : fret==3 || fret==5 || fret==7 || fret==9 ||
  fret==15 || fret==17 || fret==19 ? 1 : 0;
);
function draw_guitar(x,y,w,h,scale_view) local(open_w,fw,fret,string,kx,sy,n,role,marker,ch,hw,radius,marker_radius,anchor_state) (
  open_w=26; fw=(w-open_w)/guitar_max_fret;
  radius=(keyboard_black_width(w)-1)/2; marker_radius=2.5;
  ink(diagram_background_color,1); gfx_rect(x,y,w,h);
  fret=0; loop(guitar_max_fret+1,
    kx=x+open_w+fret*fw;
    ink(fret==0 ? guitar_nut_color : guitar_fret_color,1);
    gfx_rect(theme_dark ? floor(kx)-1 : kx-1,y,fret==0 ? 3 : theme_dark ? dark_diagram_line_width : 1,h);
    fret+=1;
  );
  string=0; loop(6,
    sy=floor(y+11+string*(h-22)/5+.5);
    ink(guitar_string_color,.7); gfx_rect(x,sy-(string>=3 ? 1 : 0),w,string>=3 ? 3 : 1);
    string+=1;
  );
  string=0; loop(6,
    sy=floor(y+11+string*(h-22)/5+.5);
    fret=0; loop(guitar_max_fret+1,
      kx=fret==0 ? x+open_w/2 : x+open_w+(fret-.5)*fw;
      n=guitar_open(string)+fret;
      role=display_role(n,scale_view);
      role>=0 ? note_dot(kx,sy,role,n,scale_view,radius) : external_dot(kx,sy,n,scale_view);
      fret+=1;
    );
    string+=1;
  );
  fret=0; loop(guitar_max_fret+1,
    kx=fret==0 ? x+open_w/2 : x+open_w+(fret-.5)*fw;
    // Upper row = selectable index anchors for this chord, not fixed fret inlays.
    // Keep it in the existing 12px gap, clear of both keyboard and top string.
    !game_on && voicing_mode && !scale_view ? (
      anchor_state=guitar_anchor_state(fret);
      anchor_state ? (
        ink(anchor_state==2 ? text_color : text_muted_color,1);
        gfx_circle(kx,y-6,marker_radius,anchor_state==2,1);
      );
    );
    marker=fret_marker(fret); ink(text_muted_color,1);
    marker==1 ? gfx_circle(kx,y+h+13,marker_radius,1,1);
    marker==2 ? (gfx_circle(kx-5,y+h+13,marker_radius,1,1); gfx_circle(kx+5,y+h+13,marker_radius,1,1););
    fret+=1;
  );
);
function normal_chord_choice_text(d) local(index,bass) (
  index=saved+d*4;
  d==0 ? strcpy(#roman,"I") : d==1 ? strcpy(#roman,"ii") : d==2 ? strcpy(#roman,"iii") :
  d==3 ? strcpy(#roman,"IV") : d==4 ? strcpy(#roman,"V") : d==5 ? strcpy(#roman,"vi") :
  strcpy(#roman,index[1]==0 ? "vii°" : "viiø");
  bass=chord_note(key,d,index[2],0,index[3],3+index[1]);
  voicing_mode ? (
    bass=guitar_bass(guitar_region_record(key,d,index[1],guitar_saved[d]));
    spell_pitch(#bass,key,bass);
  ) : spell_note(#bass,key,d+voice_role(index[2],3+index[1])*2);
  spell_note(#root,key,d); chord_quality(#quality,d,index[1]);
  index[1]==0 && strcmp(#quality,"M")==0 ? strcpy(#quality,"");
  chord_tone_label(#bass_role,bass%12,(key+major_step(d))%12,chord_role(bass%12,key,d,3+index[1]));
  sprintf(#text,"%s %s%s/%s%d(%s)",#roman,#root,#quality,#bass,floor(written_step(key,bass)/7),#bass_role);
  index[0] ? strcat(#text," *");
);
function chord_choice_text(d) (
  game_on && game_count>0 ? game_choice_text(d) : normal_chord_choice_text(d);
);
function chord_choice_selected(d) (
  game_on ? (game_count>0 && d==game_choice_degree()) : degree==d;
);
function chord_choice_role(d) (
  // Fixed to the selected major signature, never rebase on a minor tonic/chord.
  scale_role(game_on && game_count>0 ? game_scale[d] : (key+major_step(d))%12,display_key());
);
// Fit once for BOTH rows, never resize only one label or the selected label.
function measure_choice_text() local(i,tw,th,fit,w) (
  fit=1; gfx_setfont(1,"DejaVu Sans",choices_font_size*font_scale);
  w=floor((gfx_w-key_choices_reserve-game_button_reserve)/12)-2*choices_inset-4;
  i=0; loop(12,
    key_pair_name(#text,i); gfx_measurestr(#text,tw,th);
    fit=min(fit,w/max(1,tw)); i+=1;
  );
  w=floor((gfx_w-36)/7)-2*choices_inset-8;
  i=0; loop(7,
    chord_choice_text(i); gfx_measurestr(#text,tw,th);
    fit=min(fit,w/max(1,tw)); i+=1;
  );
  choices_text_size=choices_font_size*fit;
);
function draw_key_choices(y) local(i,x,w,locked) (
  locked=game_on || sounding || (play_state&1) || play_state==5;
  ink(button_color,1); capsule(18,y,gfx_w-36,choices_height);
  i=0; loop(12,
    key_pair_name(#text,i);
    x=floor(18+i*(gfx_w-key_choices_reserve-game_button_reserve)/12); w=floor(18+(i+1)*(gfx_w-key_choices_reserve-game_button_reserve)/12)-x;
    choice_button(x,y,w,#text,display_key()==i,locked) ? ui_command(i);
    i+=1;
  );
  // CLAP editor owns the circular Sustain and Active controls to the right.
);
function draw_chord_choices(y) local(i,d,x,w,selected) (
  ink(button_color,1); capsule(18,y,gfx_w-36,choices_height);
  i=0; loop(7,
    d=(i+5)%7;
    selected=chord_choice_selected(d); x=floor(18+i*(gfx_w-36)/7); w=floor(18+(i+1)*(gfx_w-36)/7)-x;
    chord_choice_text(d);
    chord_choice_button(x,y,w,#text,selected,game_on,chord_choice_role(d)) ? ui_command(12+i);
    i+=1;
  );
);
function ui_begin() (
  ui_heartbeat=time_precise();
  clicked=(mouse_cap&1) && !(previous_mouse&1);
  !(mouse_cap&1) && (previous_mouse&1) ? ui_command(24);
  previous_mouse=mouse_cap;
  gfx_clear=0;
  ink(background_color,1); gfx_rect(0,0,gfx_w,gfx_h);
);
function draw_maps(x,y,w,piano_height,guitar_height,scale_view) (
  draw_keyboard(x,y,w,piano_height,scale_view);
  draw_guitar(x,y+piano_height+12,w,guitar_height,scale_view);
);
