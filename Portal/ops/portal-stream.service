[Unit]
Description=Portal YouTube Music audio engine
After=pipewire.service wireplumber.service

[Service]
ExecStart=/usr/bin/mpv --no-config --include=%h/.config/portal/mpv.conf --input-ipc-server=%t/portal-stream/mpv.sock
RuntimeDirectory=portal-stream
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardInput=null
# Resolver logs can contain signed URLs. Do not write them into the journal.
StandardOutput=null
StandardError=null
